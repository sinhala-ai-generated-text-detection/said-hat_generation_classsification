# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.venv/
venv/

# Environment
.env

# Project data — lives in the shared Google Drive, not git
outputs/*
source_data/*
!source_data/.gitkeep
!outputs/.gitkeep

# Mode allocations ARE committed (unlike the data above) — every team member's
# generate.py / run_pilot.py run must read the exact same source_id -> (mode, variant)
# assignment, not regenerate their own. Keep these tracked in git.
!config/mode_allocations/*.json

# Local run-state, regenerated by generate.py
logs/*
!logs/.gitkeep

# OS / editor
.DS_Store
.vscode/
.idea/
