AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
# AWS_SESSION_TOKEN=your_session_token_here   # only needed for temporary/SSO credentials
AWS_REGION=us-east-1                          # must be a region where your account has Bedrock model access

# If you already use an AWS profile (e.g. via `aws configure` or SSO), you can leave the
# keys above unset — boto3 will fall back to your default credential chain instead.
